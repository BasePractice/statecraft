    table.hline(),
    [$a_0$], [$1 S q_0$], [$1 S q_0$],
    [$0$], [$1 S q_0$], [$1 S q_0$],
    [$1$], [$2 S q_0$], [$2 S q_0$],
    [$2$], [$3 S q_0$], [$3 S q_0$],
    [$3$], [$4 S q_0$], [$4 S q_0$],
    [$4$], [$5 S q_0$], [$5 S q_0$],
    [$5$], [$6 S q_0$], [$6 S q_0$],
    [$6$], [$7 S q_0$], [$7 S q_0$],
    [$7$], [$8 S q_0$], [$8 S q_0$],
    [$8$], [$9 S q_0$], [$9 S q_0$],
    [$9$], [$0 L q_2$], [$0 L q_2$],
  )]
  , caption: [$M$ для функции $y = x + 1$: $q_1$ --- первый разряд, $q_2$ --- обработка переноса]
  , kind: table
