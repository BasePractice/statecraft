  table(
    columns: 4,
    align: (center, left, left, left),
    table.header[Тип][Модель вычислений][Класс языков][Пример языка],
    [3], [конечный автомат], [регулярные], [слова с чётным числом $a$],
    [2], [автомат с магазинной памятью], [контекстно-свободные], [$a^n b^n$, скобочные последовательности],
