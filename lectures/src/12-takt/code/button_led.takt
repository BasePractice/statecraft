/* Порты и внешняя функция: кнопка переключает светодиод.
   Порт in/out — типизированная замена указателю MMIO;
   extern fn — вызов процедуры, реализованной вне модели (в C-драйвере). */
extern fn led_write(value: u8);

fn toggle(value: u8) -> u8 {
    return ~value;
}

model ButtonLED {
    in btn: bit;
    out led: u8 := 0;

    var level: u8 := 0;

    start Idle {
        ref Pressed: btn = 1;
    }

    state Pressed {
        enter {
            level := toggle(level);
            led := level;
            led_write(level);
        }
        ref Idle: btn = 0;
    }
}

start Root = ButtonLED;
