/* verify: ok
 *
 * Светофор с кнопкой пешехода — тот же автомат, что в лекции 2 (§ 3.2).
 * Пять состояний: G (зелёный машинам), G_REQ (заявка принята, идёт
 * минимальная выдержка), Y, R (идут пешеходы), RY.
 *
 * Проверяются два свойства:
 *   safety   — зелёный машинам и разрешение пешеходам никогда не совпадают;
 *   liveness — нажатая кнопка рано или поздно приводит к разрешению перехода.
 *
 * Второе свойство требует предположения о справедливости планировщика:
 *   spin -a 10.TrafficLight.pml
 *   cc -o pan pan.c && ./pan -a -f -N liveness
 * Без -f верификатор находит «нарушение», в котором процесс контроллера
 * просто никогда не выполняется, — это дефект не модели, а постановки
 * вопроса.
 */

mtype = { G, G_REQ, Y, R, RY }

mtype light = G;
bool button;  /* заявка пешехода принята к обработке */
bool walk;    /* пешеходам разрешено идти */

active proctype controller() {
    do
    :: light == G ->
       if
       :: button -> light = G_REQ   /* заявка ждёт минимальной выдержки */
       :: else -> skip
       fi
    :: light == G_REQ -> light = Y
    :: light == Y -> light = R; walk = true
    :: light == R ->
       walk = false;
       button = false;              /* заявка обслужена */
       light = RY
    :: light == RY -> light = G
    od
}

/*
 * Пешеход нажимает кнопку, когда заявки нет. Ветки «ничего не делать» здесь
 * быть не должно: безусловная петля в do — это состояние, из которого модель
 * может не выходить никогда, и SPIN отвергает такую модель как заведомо
 * незавершаемую.
 */
active proctype pedestrian() {
    do
    :: !button -> button = true
    od
}

/* Безопасность: машинам и пешеходам никогда не разрешено одновременно. */
ltl safety { [] !(light == G && walk) }

/* Живость: заявка не может быть проигнорирована навсегда. */
ltl liveness { [] (button -> <> walk) }
