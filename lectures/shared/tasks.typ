// lectures/shared/tasks.typ — задачник курса.
//
// Закрывает замечание REPORT.md §3.5: в исходных материалах было три задания
// «сделайте самостоятельно» без ответов и критериев. Уровень сложности —
// поле level (1..3), печатается звёздочками.

#import "/template/i18n.typ": L
#import "/template/theme.typ": palette

#let bank = (
  "01-intro": (
    (level: 1, body: [Формализуйте работу турникета: выпишите входной и выходной алфавиты, множество состояний и словесное описание переходов.]),
    (level: 1, body: [Для алфавита $A = {a, b}$ выпишите все слова длины не более 3. Сколько их? Обобщите на длину $n$.]),
    (level: 2, body: [Приведите пример языка, который нельзя задать перечислением, но можно задать словесно.]),
  ),
  "02-fsm": (
    (level: 1, body: [Постройте диаграмму Мура для автомата, выдающего 1 тогда и только тогда, когда на вход подана последовательность 1101.]),
    (level: 2, body: [Задайте детектор фронта (изменения входного сигнала с 0 на 1) в моделях Мили и Мура. Сравните число состояний.]),
    (level: 2, body: [Постройте автомат антидребезга кнопки: выход меняется, только если вход держится неизменным три такта подряд.]),
    (level: 3, body: [Докажите, что любой автомат Мура можно преобразовать в эквивалентный автомат Мили, не увеличивая числа состояний, а обратное преобразование в общем случае требует их увеличения.]),
  ),
  "03-synthesis": (
    (level: 1, body: [Закодируйте состояния разменного аппарата двоичными векторами и выпишите таблицу переходов.]),
    (level: 2, body: [Постройте карту Карно для функции возбуждения одного из триггеров разменного аппарата и минимизируйте её.]),
    (level: 2, body: [Синтезируйте автомат управления шлагбаумом: два концевых выключателя, фотобарьер, кнопка. Опишите поведение при обрыве датчика.]),
    (level: 3, body: [Синтезируйте автомат управления лифтом трёхэтажного здания; оцените число состояний при разных вариантах кодирования.]),
  ),
  "04-dfa-nfa": (
    (level: 1, body: [Постройте ДКА для языка $L = {w in {a, b}^* : |w|_a$ чётно$}$.]),
    (level: 1, body: [Постройте ДКА, распознающий двоичные записи чисел, кратных 3. Хватит трёх состояний.]),
    (level: 2, body: [Детерминизируйте НКА, распознающий слова, оканчивающиеся на `abb`. Сколько состояний получилось?]),
    (level: 2, body: [Минимизируйте автомат из предыдущей задачи алгоритмом разбиения на классы эквивалентности.]),
    (level: 3, body: [Постройте НКА с $n$ состояниями, детерминизация которого даёт ровно $2^n$ достижимых состояний.]),
  ),
  "05-kleene": (
    (level: 1, body: [Выпишите регулярное выражение для языка слов над ${a, b}$, содержащих подслово `aba`.]),
    (level: 2, body: [Для выражения `(a|b)*abb` постройте $epsilon.alt$-НКА конструкцией Томпсона, детерминизируйте и минимизируйте его.]),
    (level: 2, body: [Постройте регулярное выражение по автомату методом исключения состояний.]),
    (level: 3, body: [С помощью леммы о накачке докажите, что язык правильных скобочных последовательностей не регулярен.]),
  ),
  "06-regexp": (
    (level: 1, body: [Составьте регулярное выражение для номера версии вида `1.2.3` с необязательным суффиксом.]),
    (level: 2, body: [Напишите лексер формата CSV с кавычками по RFC 4180 двумя способами: вручную как ДКА на четырёх состояниях и регулярными выражениями. Сравните.]),
    (level: 2, body: [Измерьте время сопоставления `^(a+)+$` со строками `a`⁠ⁿ`X` при $n = 10, 20, 25, 30$. Объясните результат.]),
    (level: 3, body: [Постройте декодер UTF-8 как ДКА и сравните его с таблицей Бьорна Хёрмана.]),
  ),
  "07-automata-prog": (
    (level: 1, body: [Перепишите пример из `_2.Practice/08.Simple_Program` с вложенными `switch` и `if` в виде явного автомата.]),
    (level: 2, body: [Реализуйте один и тот же управляющий автомат тремя способами: `while`+`switch`, таблица переходов с указателями на функции, паттерн State. Сравните по объёму кода, читаемости и скорости.]),
    (level: 2, body: [Проверьте ортогональность условий переходов в своём автомате: составьте таблицу и найдите входные наборы, при которых срабатывают два перехода сразу.]),
    (level: 3, body: [Напишите набор тестов, покрывающий все переходы автомата управления шлагбаумом, и обоснуйте полноту покрытия.]),
  ),
  "08-statecharts": (
    (level: 1, body: [Опишите режим паузы стиральной машины плоским автоматом, затем иерархическим. Сравните число переходов.]),
    (level: 2, body: [Добавьте к автомату стиральной машины ортогональный регион индикации и обработку обрыва датчика.]),
    (level: 2, body: [Соберите модель циклограммы двух пневмоцилиндров в SimInTech, сгенерируйте код и сверьте его поведение с `simulate.process`.]),
    (level: 3, body: [Опишите тот же автомат на SFC по IEC 61131-3 и сопоставьте конструкции с диаграммой состояний UML.]),
  ),
  "09-verification": (
    (level: 1, body: [Запишите на LTL требование «после нажатия кнопки лифт когда-нибудь приедет».]),
    (level: 2, body: [Опишите на Promela взаимное исключение двух процессов и найдите с помощью SPIN нарушение при снятии одного из условий.]),
    (level: 2, body: [Постройте спецификацию светофора и проверьте отсутствие состояния, в котором зелёный горит в обоих направлениях.]),
    (level: 3, body: [Постройте установочную и диагностическую последовательности для автомата из лекции 4 и обоснуйте их минимальность.]),
  ),
  "10-limits": (
    (level: 1, body: [Составьте программу машины Тьюринга для $y = x + 1$ в унарной записи и проверьте её на симуляторе.]),
    (level: 2, body: [Составьте программу машины Тьюринга, копирующей слово: $w -> w w$.]),
    (level: 2, body: [Постройте МП-автомат, распознающий язык $a^n b^n$, и сравните его с попыткой сделать то же конечным автоматом.]),
    (level: 3, body: [Найдите значения $B B(1)$, $B B(2)$, $B B(3)$ перебором и объясните, почему такой перебор не масштабируется.]),
  ),
)

#let _c = counter("task")

#let tasks-section(id) = {
  let ts = bank.at(id, default: ())
  if ts.len() == 0 { return }
  pagebreak(weak: true)
  heading(level: 1, numbering: none, L.tasks)
  _c.update(0)
  for t in ts {
    _c.step()
    block(
      width: 100%,
      inset: (left: 11pt, y: 6pt),
      stroke: (left: 2.5pt + palette.task),
    )[
      #strong[Задача #context _c.display()]
      #h(0.5em)
      #text(size: 8.5pt, fill: palette.muted)[#("*" * t.level)]
      #linebreak() #t.body
    ]
  }
}
