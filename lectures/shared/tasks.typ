#let _c = counter("task")

#let tasks-section(id) = {
  let ts = bank.at(id, default: ())
  if ts.len() == 0 { return }
  pagebreak(weak: true)
  heading(level: 1, numbering: none, L.tasks)
  _c.update(0)
  for t in ts {
    _c.step()
    block(
      width: 100%,
      inset: (left: 11pt, y: 6pt),
      stroke: (left: 2.5pt + palette.task),
    )[
      #strong[Задача #context _c.display()]
      #h(0.5em)
      #text(size: 8.5pt, fill: palette.muted)[#("*" * t.level)]
      #linebreak() #t.body
      #if course.show-answers and t.at("answer", default: none) != none [
        #v(3pt)
        #text(size: sizes.small, fill: palette.muted)[
          #strong[Ответ.] #t.answer
        ]
      ]
    ]
  }
}
