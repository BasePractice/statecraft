// Система управления транспортным погрузчиком цеха.
//
// Погрузчик едет по разметке на полу и распознаёт своё место по меткам RFID,
// вделанным в пол на пересечениях линий. Куда ехать, решает не он: маршрут
// планирует система верхнего уровня (practices/21-additional/route.c) и выдаёт
// погрузчику команды по одной. Это разделение принципиально — поиск пути
// требует памяти (очередь, пометки посещённого) и конечным автоматом не
// решается, а вот исполнение команды автоматом описывается точно.
//
// Команды (совпадают с enum LoaderCommandCode из route.h):
//   1 — повернуть налево на 90°
//   2 — повернуть направо на 90°
//   3 — ехать по линии до метки cmd_point
//   4 — поднять груз вилами
//
// Направление отсчитывается по часовой стрелке от «вверх»:
//   0 — вверх, 1 — вправо, 2 — вниз, 3 — влево.
//
// Архитектура — четыре параллельные модели:
//   CommandReceiver — приём команды и квитирование её исполнения
//   DriveController — повороты и движение по линии до метки
//   LiftController  — вилы
//   SafetyMonitor   — сторож: погрузчик не может ехать вечно
//
// Оригинал (репозиторий c_fsm, transport_loader_gui.cpp) устроен иначе:
// автомат исполнения там подключался из чужого репозитория готовым кодом, а
// сверки прочитанной метки с ожидаемой не было вовсе — погрузчик, промахнувшись
// мимо поворота, продолжал ехать «по плану». Здесь такая метка — авария.

// ─── О проверке свойств ───────────────────────────────────────────────────────
//
// Главное свойство безопасности этой модели — «пока держится авария,
// погрузчик не едет»: G (faulted -> !moving). Записать его как LTL-свойство
// здесь нельзя, и причина в инструменте, а не в модели: `taktc verify`
// абстрагирует управление (условия переходов не учитываются, присваивания в
// enter не отслеживаются), а имена состояний вложенных моделей при композиции
// вне его охвата. Проверка такого свойства даёт контрпример вида [ Loader ]*
// на любой модели, даже на модели из трёх состояний.
//
// Само свойство при этом небесполезно: попытка его проверить и показала, что
// сторож поднимал аварию, не снимая газ, — см. состояние Tripped. Проверяется
// оно сценарием симулятора (scenario/loader.json) и прогоном драйвера.
//
// ─── Коды команд ──────────────────────────────────────────────────────────────
const CMD_TURN_LEFT: u8 := 1;
const CMD_TURN_RIGHT: u8 := 2;
const CMD_DRIVE: u8 := 3;
const CMD_LIFT: u8 := 4;

// ─── Направления ──────────────────────────────────────────────────────────────
const DIR_UP: u8 := 0;
const DIR_RIGHT: u8 := 1;
const DIR_DOWN: u8 := 2;
const DIR_LEFT: u8 := 3;

// ─── Входные порты: задание и датчики ─────────────────────────────────────────
in cmd_valid: bit at 0x100:0;   // команда предъявлена и держится до квитирования
in cmd_code: u8 at 0x101:0;     // код команды
in cmd_point: u16 at 0x102:0;   // «ехать» — номер метки, «взять» — код паллеты
in cmd_extra: u16 at 0x103:0;   // «взять» — код места (штабеля), иначе 0
in cmd_timeout: duration at 0x104:0; // сколько отведено на эту команду

in sense_line: bit at 0x200:0;      // датчик разметки: линия под погрузчиком
in sense_point: u8 at 0x201:0;      // метка RFID под считывателем, 0 — метки нет
in sense_angle: u8 at 0x202:0;      // текущее направление, 0…3
in sense_odometer: u16 at 0x205:0;  // энкодер: пройденный путь, см
in sense_range: u8 at 0x206:0;      // дальномер: до препятствия впереди, см
in sense_motion: bit at 0x207:0;    // акселерометр: погрузчик действительно едет
in sense_stack: u16 at 0x208:0;     // сканер места: код штабеля (RFID или штрих-код)
in sense_pallet: u16 at 0x209:0;    // сканер вил: код паллеты, 0 — ничего не прочитано
in sense_load: bit at 0x20a:0;      // тензодатчик вил: груз принят
in reset: bit at 0x204:0;           // квитирование аварии оператором

// ─── Выходные порты: команды приводам и ответ системе верхнего уровня ─────────
out cmd_ack: bit at 0x300:0;    // команда принята к исполнению
out cmd_done: bit at 0x301:0;   // команда исполнена
out drive_gas: bit at 0x400:0;  // ехать вперёд
out turn_left: bit at 0x401:0;  // поворот на месте налево
out turn_right: bit at 0x402:0; // поворот на месте направо
out fork_up: bit at 0x403:0;    // поднять вилы
out fault: bit at 0x500:0;      // авария: движение прекращено

// ─── Рабочие переменные ───────────────────────────────────────────────────────
var op: u8 := 0;            // код исполняемой команды
var target_point: u16 := 0; // метка, до которой едем, либо код паллеты
var target_stack: u16 := 0; // код места, у которого берём паллету
var target_angle: u8 := 0;  // направление, в котором должен встать погрузчик
var busy: bit := 0;         // команда исполняется
var faulted: bit := 0;      // авария (видна всем моделям)
var moving: bit := 0;       // копия drive_gas: выходной порт читать нельзя (SE-027)
var odo_mark: u16 := 0;     // показание энкодера у последней прочитанной метки
var deadline: duration := 0s; // срок на текущую команду, посчитанный планировщиком
var fault_request: bit := 0;  // любая из моделей просит остановить работу

// ─── Пределы, заданные в физических величинах ─────────────────────────────────
//
// Обе величины — сантиметры, и обе сравниваются с показаниями датчиков. В
// тактах их задавать нельзя: такт — шаг логики, его частота произвольна, и
// «двести тактов» на другой платформе означают другое расстояние.
const SPAN_LIMIT: u16 := 400; // между соседними метками не больше 4 м пути
const STOP_RANGE: u8 := 40;   // ближе 40 см к препятствию ехать нельзя

// ─── Именованные условия ──────────────────────────────────────────────────────
cond OnLine = sense_line = 1;
cond OffLine = sense_line = 0;
cond AtTarget = sense_point = target_point;
cond AtWrongPoint = sense_point != 0 & sense_point != target_point;
cond Faulted = faulted = 1;
cond Healthy = faulted = 0;
cond FaultRequested = fault_request = 1;

// Перебег: от последней метки проехали больше, чем метки вообще расставлены.
// Разность беззнаковая, поэтому обёртка энкодера считается верно.
cond Overrun = sense_odometer - odo_mark > SPAN_LIMIT;
cond Obstacle = sense_range < STOP_RANGE;

// Место и паллета опознаются сканерами, а не «предполагаются по маршруту».
cond AtStack = sense_stack = target_stack;
cond WrongStack = sense_stack != 0 & sense_stack != target_stack;
cond PalletTaken = sense_pallet = target_point & sense_load = 1;
cond WrongPallet = sense_pallet != 0 & sense_pallet != target_point;

// ─── Модель 1: приём команды ──────────────────────────────────────────────────
//
// Команда держится системой верхнего уровня, пока не придёт cmd_done: так
// исполнителю не нужен буфер, а планировщику — угадывать, успел ли автомат
// прочитать код.
model CommandReceiver {
    start Waiting {
        enter {
            cmd_ack := 0;
            cmd_done := 0;
        }
        ref Accepting: cmd_valid = 1 & busy = 0 & Healthy;
    }

    // Код команды и её аргумент запоминаются один раз — дальше исполнители
    // работают с переменными, а не с портами. Иначе смена задания посреди
    // движения незаметно меняла бы цель.
    state Accepting {
        enter {
            op := cmd_code;
            target_point := cmd_point;
            target_stack := cmd_extra;
            deadline := cmd_timeout;
            busy := 1;
            cmd_ack := 1;
        }
        next Active;
    }

    state Active {
        enter {
            cmd_ack := 0;
        }
        ref Reporting: busy = 0 & Healthy;
        ref Waiting: Faulted;
    }

    // Квитирование: сигнал держится, пока верхний уровень не снимет команду.
    // Импульс в один такт здесь не годится — драйвер опрашивает автомат реже,
    // чем тот тикает, и импульс можно проспать.
    state Reporting {
        enter {
            cmd_done := 1;
        }
        ref Waiting: cmd_valid = 0;
    }
}

// ─── Модель 2: движение ───────────────────────────────────────────────────────
model DriveController {
    start DriveIdle {
        enter {
            drive_gas := 0;
            moving := 0;
            turn_left := 0;
            turn_right := 0;
        }
        ref DriveFault: busy = 1 & op = CMD_DRIVE & target_point = 0;
        ref Turning: busy = 1 & (op = CMD_TURN_LEFT | op = CMD_TURN_RIGHT) & Healthy;
        ref Leaving: busy = 1 & op = CMD_DRIVE & Healthy;
    }

    // Целевое направление вычисляется здесь, а не планировщиком: планировщик
    // говорит «налево», а куда это, зависит от того, как погрузчик стоит.
    // Вычитание единицы из нуля дало бы 255 (обёртка u8), поэтому край круга
    // разбирается явно.
    state Turning {
        enter {
            if op = CMD_TURN_LEFT {
                if sense_angle = DIR_UP {
                    target_angle := DIR_LEFT;
                } else {
                    target_angle := sense_angle - 1;
                }
                turn_left := 1;
            } else {
                if sense_angle = DIR_LEFT {
                    target_angle := DIR_UP;
                } else {
                    target_angle := sense_angle + 1;
                }
                turn_right := 1;
            }
        }
        ref DriveDone: sense_angle = target_angle;
        ref DriveFault: Faulted;
    }

    // Сход с метки, на которой стоим. Без этого состояния автомат принял бы
    // метку под собой за конец пути и «доехал» бы, не сдвинувшись. Отсчёт
    // перебега ведётся от показания энкодера в этот момент.
    state Leaving {
        enter {
            drive_gas := 1;
            moving := 1;
            odo_mark := sense_odometer;
        }
        ref Driving: sense_point = 0 & sense_motion = 1 & OnLine;
        ref DriveFault: OffLine | Obstacle | Faulted;
    }

    // Условия выхода непересекающиеся и покрывающие: либо приехали, либо
    // случилось то, из-за чего ехать дальше нельзя. Всё, кроме собственной
    // цели, автомат узнаёт от датчиков: разметка под собой, метка под
    // считывателем, путь по энкодеру, препятствие по дальномеру.
    state Driving {
        ref DriveDone: OnLine & AtTarget & Healthy;
        ref DriveFault: OffLine | AtWrongPoint | Obstacle | Overrun | Faulted;
    }

    state DriveDone {
        enter {
            drive_gas := 0;
            moving := 0;
            turn_left := 0;
            turn_right := 0;
            busy := 0;
        }
        next DriveIdle;
    }

    // Отказ не объявляется здесь аварией — здесь он о ней просит. Защёлкивает
    // и снимает аварию единственный владелец, модель FaultLatch: иначе
    // квитирование зависит от того, кто из моделей тикнул раньше.
    state DriveFault {
        enter {
            drive_gas := 0;
            moving := 0;
            turn_left := 0;
            turn_right := 0;
            fault_request := 1;
            busy := 0;
        }
        ref DriveIdle: Healthy;
    }
}

// ─── Модель 3: вилы ───────────────────────────────────────────────────────────
//
// Груз не «поднимается вслепую по команде»: сначала сканер места читает код
// штабеля и он сверяется с заданием, потом вилы идут вверх, и только когда
// сканер на вилах прочитал код нужной паллеты, а тензодатчик показал нагрузку,
// команда считается исполненной. Чужой код — на месте или на паллете — авария,
// а не повод продолжать.
model LiftController {
    start LiftIdle {
        enter {
            fork_up := 0;
        }
        ref LiftCheck: busy = 1 & op = CMD_LIFT & Healthy;
    }

    // Сверка места. Сканер может ещё ничего не прочитать (код 0) — тогда просто
    // ждём: вилы поднимать рано.
    state LiftCheck {
        ref LiftFault: WrongStack | Faulted;
        ref Lifting: AtStack;
    }

    state Lifting {
        enter {
            fork_up := 1;
        }
        ref LiftFault: WrongPallet | Faulted;
        ref LiftDone: PalletTaken;
    }

    // Вилы остаются поднятыми: снимается команда, а не груз.
    state LiftDone {
        enter {
            busy := 0;
        }
        next LiftIdle;
    }

    state LiftFault {
        enter {
            fork_up := 0;
            fault_request := 1;
            busy := 0;
        }
        ref LiftIdle: Healthy;
    }
}

// ─── Модель 4: сторож ─────────────────────────────────────────────────────────
//
// Сторож смотрит за двумя вещами, и обе — показания датчиков, а не счёт
// тактов и не выдержка. Первая: путь от последней метки по энкодеру. Метки
// расставлены не реже SPAN_LIMIT, поэтому больший перебег означает, что
// погрузчик едет не по маршруту — датчик линии ещё держится за случайную
// полосу, а метка уже пропущена. Вторая: дальномер. Препятствие ближе
// STOP_RANGE — стоп независимо от того, что велит план.
//
// В оригинале не было ни того, ни другого: уехавший погрузчик останавливался
// только оператором.
model SafetyMonitor {
    start Watching {
        // Точка отсчёта перебега обновляется каждой прочитанной меткой.
        always {
            if sense_point != 0 {
                odo_mark := sense_odometer;
            }
        }
        ref Tripped: moving = 1 & (Overrun | Obstacle);
    }

    state Tripped {
        enter {
            /*
             * Газ снимает сам сторож, а не исполнитель. Иначе между «отказ
             * замечен» и «привод остановлен» проходит такт: DriveController
             * увидел бы просьбу только на следующем шаге.
             */
            drive_gas := 0;
            moving := 0;
            fault_request := 1;
        }
        ref Watching: Healthy;
    }
}

// ─── Модель 5: сторожевой таймер команды ──────────────────────────────────────
//
// Датчики ловят то, что уже случилось: перебег, препятствие, чужую метку. Но
// есть отказ, при котором датчики молчат: двигатель включён, погрузчик стоит
// (буксует, упёрся, отказал привод) или ползёт медленнее расчётного. Тогда
// команда просто никогда не завершится — и её обязан снять таймер.
//
// Срок берётся не из головы и не «в тактах»: планировщик знает длину перегона
// и паспортную скорость машины, считает время команды и передаёт его портом
// cmd_timeout (см. LoaderTiming в route.h). Автомат прибавляет запас MARGIN на
// разгон, торможение и считывание метки.
model CommandWatchdog {
    start Idle {
        ref Timing: busy = 1;
    }

    // Отсчёт идёт от входа в состояние, то есть от приёма команды; исполнение
    // команды (busy = 0) снимает таймер раньше срока — это штатный выход.
    state Timing {
        ref Idle: busy = 0;
        ref Expired: after (deadline + 2s);
    }

    state Expired {
        enter {
            drive_gas := 0;
            moving := 0;
            turn_left := 0;
            turn_right := 0;
            fork_up := 0;
            fault_request := 1;
            busy := 0;
        }
        ref Idle: Healthy;
    }
}

// ─── Модель 6: владелец аварии ────────────────────────────────────────────────
//
// Аварию замечают четверо: исполнитель движения, вилы, сторож и таймер. Если
// каждый из них сам поднимает и сам снимает признак аварии, квитирование
// начинает зависеть от порядка, в котором модели тикают: одна успела снять,
// другая в том же такте выставила заново, и `reset` перестал работать. Ровно
// это и произошло при первом прогоне сценария.
//
// Поэтому признак принадлежит одной модели. Остальные только просят
// (fault_request), а защёлкивает, держит и снимает — она, и тикает она
// последней в композиции.
model FaultLatch {
    start Clear {
        enter {
            fault := 0;
            faulted := 0;
            fault_request := 0;
        }
        ref Latched: FaultRequested;
    }

    state Latched {
        enter {
            fault := 1;
            faulted := 1;
        }
        ref Clear: reset = 1;
    }
}

start Loader = CommandReceiver | DriveController | LiftController | SafetyMonitor
             | CommandWatchdog | FaultLatch;
