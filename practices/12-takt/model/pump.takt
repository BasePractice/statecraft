/* Параллельная композиция: насос и сигнализация тикают на одном такте.
   В C это два вложенных экземпляра, вызываемых из одного tick. */
var level: u8 := 0;
var pump_on: bit := 0;

model Pump {
    const HIGH: u8 := 80;
    const LOW: u8 := 20;

    start Filling {
        enter  { pump_on := 1; }
        always { level := level + 5; }
        ref Draining: level >= HIGH;
    }

    state Draining {
        enter  { pump_on := 0; }
        always { if level > 0 { level := level - 3; } }
        ref Filling: level <= LOW;
    }
}

model Alarm {
    out siren: bit := 0;

    start Quiet {
        ref Screaming: level >= 95;
    }

    state Screaming {
        enter { siren := 1; }
        ref Quiet: level < 95;
    }
}

start Root = Pump | Alarm;
