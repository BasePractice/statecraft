# Разменный аппарат из лекции 3.
#
# В аппарат бросают монету достоинством 1, 3, 5 или 10 копеек, он выдаёт
# трёхкопеечные монеты и запоминает долг: состояние — сколько копеек
# аппарат должен, то есть (сумма) mod 3.
#
# q(t+1) = (q(t) + x(t)) mod 3,   y(t) = floor((q(t) + x(t)) / 3)
name coin
inputs 1 3 5 10
outputs 0 1 2 3 4
states 0 1 2

0 1 -> 1 0
0 3 -> 0 1
0 5 -> 2 1
0 10 -> 1 3

1 1 -> 2 0
1 3 -> 1 1
1 5 -> 0 2
1 10 -> 2 3

2 1 -> 0 1
2 3 -> 2 1
2 5 -> 1 2
2 10 -> 0 4
