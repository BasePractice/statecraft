# Детектор последовательности 1101 из лекции 2 (автомат Мили).
#
# Состояние — длина уже совпавшего префикса слова 1101:
#   q0 — ничего, q1 — совпало «1», q2 — «11», q3 — «110».
# Выход 1 выдаётся в такт, когда вхождение только что закончилось;
# вхождения могут перекрываться, поэтому из q3 по входу 1 автомат идёт
# не в q0, а в q1: последняя единица слова начинает следующее вхождение.
name detector
inputs 0 1
outputs 0 1
states q0 q1 q2 q3

q0 0 -> q0 0
q0 1 -> q1 0

q1 0 -> q0 0
q1 1 -> q2 0

q2 0 -> q3 0
q2 1 -> q2 0

q3 0 -> q0 0
q3 1 -> q1 1
