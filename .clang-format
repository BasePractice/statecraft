# Стиль кода курса. Единственный источник правды по форматированию.
#
# Составлен из требований документа _1.CodeStyle/-1.CodeStyle.md (каталог
# удалён 16.08.2026, когда правила были формализованы здесь). Требования, не
# выражаемые форматтером — именование, объявление переменных, `switch`,
# группировка скобками, — перенесены в practices/README.md.
#
# Проверка: scripts/check-style.sh, автоформат: scripts/check-style.sh --fix
#
# Соответствие пунктам исходного документа:
#   Отступы 1–2   → UseTab: Never, IndentWidth: 4
#   Отступы 4     → MaxEmptyLinesToKeep: 1
#   Отступы 5     → SpaceBeforeParens: ControlStatements, BreakBeforeBraces: Attach
#   Отступы 6     → PointerAlignment: Right (int *p, а не int* p)
#   Отступы 7     → пробелы вокруг бинарных операций (умолчание clang-format)
#   Отступы 8     → SpaceAfterCStyleCast: false ((int)x, а не (int) x)
#   Скобки 1      → BreakBeforeBraces: Attach
#   Скобки 4      → AllowShortBlocksOnASingleLine: Empty (while (a) {})
#   switch 1      → IndentCaseLabels: false
#   Разрыв 1      → ColumnLimit: 100
#   Разрыв 2      → BreakBeforeBinaryOperators: All
#
# Документ противоречил сам себе: § «Отступы», п. 2 требовал четырёх пробелов,
# а примеры кода в нём были набраны двумя. Принято правило (4) — на четырёх
# пробелах написан весь код практикума.
---
Language: Cpp
BasedOnStyle: LLVM

UseTab: Never
IndentWidth: 4
TabWidth: 4
ContinuationIndentWidth: 8
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false

BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: false

IndentCaseLabels: false

ColumnLimit: 100
BreakBeforeBinaryOperators: All
BreakBeforeTernaryOperators: true

SpaceBeforeParens: ControlStatements
SpacesInParentheses: false
SpaceAfterCStyleCast: false

PointerAlignment: Right
DerivePointerAlignment: false

# Порядок включений не переставляем: в C90-коде он значим
SortIncludes: Never
IndentPPDirectives: None
AlignTrailingComments: true
ReflowComments: false
InsertNewlineAtEOF: true
